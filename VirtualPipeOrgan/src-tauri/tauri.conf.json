{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JM-Orgue",
  "version": "0.7.50",
  "identifier": "nl.jm-orgue.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../ui && npm run dev",
    "beforeBuildCommand": "cd ../ui && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "JM-Orgue - Virtual Pipe Organ",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "minWidth": 1024,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png"
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installerHooks": "./installer-hooks.nsh",
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "linux": {
      "deb": {
        "depends": ["libasound2-dev"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1Q0FFRkI1MzBEODNGMUUKUldRZVA5Z3d0ZS9LRmZ6VGc3N3V4cm9MWlFHMERUSTlBU3ZSUTBjUytZMkJFVEJITGx3UkNodTIK",
      "endpoints": [
        "https://github.com/orgelmaker/JM-Orgue/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
